    G --> H[Entregar en tienda]
  end
  subgraph L4["Vendedor / Gerente de Tienda "]
    H --> I[Confirmar recepcion]
    I --> J[Sistema registra entrada de stock]
    J --> Z2([Fin: stock actualizado])
  end
