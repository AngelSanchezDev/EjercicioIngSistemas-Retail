flowchart LR
  subgraph L1["Vendedor / Gerente de Tienda"]
    A([Inicio]) --> B[Detectar stock bajo]
    B --> C[Crear solicitud de reposicion]
  end
  subgraph L2["Gerencia General / Admin"]
    C --> D{Evaluar solicitud}
